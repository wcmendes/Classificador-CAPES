h"},{"data":{},"content":[{"data":{},"marks":[],"value":"Learn how the interdisciplinary depth and breadth of Scopus can help drive your organization’s research forward.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"target":{"sys":{"id":"6JaUTvQT3NlpGs2RPvSLFc","type":"Link","linkType":"Entry"}},"content":{"sys":{"id":"6JaUTvQT3NlpGs2RPvSLFc"},"__typename":"Page","title":"Contact us","slug":"/products/scopus/contact-us"}},"content":[{"data":{},"marks":[],"value":"Contact us","nodeType":"text"}],"nodeType":"entry-hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"image":{"src":"//images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png","alt":"Close up of businessman writing down formulas","width":1044,"height":912},"primaryLink":null,"analyticsRegion":"hero-ctas"}},"dfa9f0b0-2029-49c1-8aca-6ac9ce3eca51":{},"ff7d675f-3e21-4c47-9776-ecfe64b41a94":{},"9ffee0f6-dcac-4eba-a5bf-8826ec8d1cbc":{"props":{"sections":[{"id":"0-Content coverage","name":"Content coverage","items":[{"id":"1hfgfKusmHtXlAWMEegMR2","componentProps":{"typeName":"TeaserGroup","props":{"title":"","teasers":[{"id":"4M7qySWZIB7UEg21ANe41T","title":"Unparalleled access to critical research from around the world","media":{"__typename":"Image","body":{"src":"https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931","alt":"Scopus Content Coverage guide","width":1260,"height":946,"transformUrl":"https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931"}},"showVideoTitle":false,"primaryLink":null,"secondaryLink":null,"body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Researchers, scholars and librarians trust the information and data they discover on Scopus because the content from more than 7,000 publishers is meticulously reviewed and selected by an independent Content Selection and Advisory Board (CSAB).","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Read about the content that Scopus offers in our ","nodeType":"text"},{"data":{"target":{"sys":{"id":"EX1iy8VxBeQKf8aN2XzOp","type":"Link","linkType":"Asset"}},"content":{"sys":{"id":"EX1iy8VxBeQKf8aN2XzOp"},"contentType":"application/pdf","title":"Scopus ContentCoverage Guide WEB","url":"//assets.ctfassets.net/o78em1y1w4i4/EX1iy8VxBeQKf8aN2XzOp/a13b1bf2789b73e04ae3436035a0682d/Scopus_Content_coverage_Guide_Jun26.pdf"}},"content":[{"data":{},"marks":[],"value":"Content Coverage Guide","nodeType":"text"}],"nodeType":"asset-hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}]}}},{"id":"5bl5EjICbROkaWjvr1xIWW","componentProps":{"typeName":"RichTextFull","props":{"document":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Scopus includes ...","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"imageWithCaption":{"image":{"src":"","alt":"","width":0,"height":0},"caption":null},"callToActionLink":null}}},{"id":"7GAAbaIQGUYGlXEdlpYejY","componentProps":{"typeName":"ImageWithCaption","props":{"caption":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Numbers shown are rounded and current as of July 2025. Scopus is updated daily.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"image":{"src":"//images.ctfassets.net/o78em1y1w4i4/sUawGK6z3SOgf2PpnntAI/33fc4ad6d3637ae230e7dc8f48ef1c12/CS-1421_Scopus_infographic_template.png","alt":"Infographic showing Scopus coverage counts","width":2560,"height":1280}}}},{"id":"3sKOpPfMgRGAp4AGr5M9Uf","componentProps":{"typeName":"Quote","props":{"quote":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Having a database as inclusive and interdisciplinary as Scopus is invaluable to us.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"author":{"name":"Bruce Abbott","initials":"BA","title":"Health Sciences Librarian at Blaisdell Medical Library, University of California, Davis Health Care (USA)","organisation":null,"imageSrc":"//images.ctfassets.net/o78em1y1w4i4/4DZbWN8j1qNlo35UjxRPaY/de55f519a5dccd06fc7fa8446cd93f84/Bruce_Abbott_headshot.jpg","imageAlt":"Headshot of Bruce Abbott","biography":null},"content":null}}},{"id":"5XySr9ZPGiDzijRqkOWtiS","componentProps":{"typeName":"TeaserGroup","props":{"title":"","teasers":[{"id":"46ehUyajJO5ZDNwo5KDhrH","title":"Preprints in Scopus","media":{"__typename":"Image","body":{"src":"//images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png","alt":"Screenshot of preprints in Scopus","width":1260,"height":772}},"showVideoTitle":false,"primaryLink":null,"secondaryLink":null,"body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Scopus incorporates 2M+ documents from seven leading preprint servers. Preprints are preliminary, unpublished, non-peer-reviewed versions of scholarly papers that precede publication and act as an early indication of research. Preprints from 2017 and onward can be explored as part of a Scopus search and are included as a content type in Author profiles.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}]}}},{"id":"1SBcZzxAUtqxfP2Cyb4Gbp","componentProps":{"typeName":"RichTextFull","props":{"document":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Historical depth: Why citations matter","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"With more than 2.4b cited references in Scopus, each publication indexed has, on average, 10-15% more citations than our nearest competitor. More cited references mean you get:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"More extensive bibliometric and historic trends analyses","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"More complete author profiles","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Improved ","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"h","nodeType":"text"},{"data":{},"marks":[],"value":"-index measures for authors","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"Want to get a better representation of your scholarly output and increase your visibility? Validate your Author Profile today to ensure your citations and ","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"h","nodeType":"text"},{"data":{},"marks":[],"value":"-index score are accurate.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"imageWithCaption":{"image":{"src":"","alt":"","width":0,"height":0},"caption":null},"callToActionLink":null}}},{"id":"6c3zet4FTZHgnAnRIpAz5v","componentProps":{"typeName":"ImageWithCaption","props":{"caption":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Content on Scopus extends back to 1788 and references date from the 1970s.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"image":{"src":"//images.ctfassets.net/o78em1y1w4i4/7H6Bo4jkfzqZGRejVpyQ4A/77d3a3f552b587a8596e652102c35a67/Scopus_historical_depth.jpg","alt":"Scopus historical depth timeline","width":800,"height":418}}}},{"id":"eLFRYke7fxrHIxjNDNTdV","componentProps":{"typeName":"RichTextFull","props":{"document":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Expertly curated content","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"We seek out and ensure that only the most trusted, peer-reviewed scientific articles, books and conference papers are available on Scopus.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"imageWithCaption":{"image":{"src":"","alt":"","width":0,"height":0},"caption":null},"callToActionLink":null}}},{"id":"5qVxcv6gGTyJ18eMpUpLUb","componentProps":{"typeName":"TeaserGroup","props":{"title":"","teasers":[{"id":"5vrk99RetvFJxXJs0NeaQs","title":"Content Selection and Advisory Board","media":{"__typename":"Video","body":{"name":"CSAB","title":"ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4","productName":"","disableVideoTitle":false,"video":{"src":"//videos.ctfassets.net/o78em1y1w4i4/6U5C8xIAARQbgHiC58icOS/6b930ab10781c48b93f151e9a06d06e0/ACAD_SC_VID_CSAB_purpose_expertcuration__1_.mp4","title":"ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4","description":"","uploadDate":"2023-09-19T13:05:08.907Z","contenttype":"video/mp4","width":1440,"height":1080,"id":"6U5C8xIAARQbgHiC58icOS"},"subtitles":{"label":"CSAB SUB EN-US","src":"//assets.ctfassets.net/o78em1y1w4i4/216xsv2QhF0c7UhkmrkFgb/408e631cf76b4ce94d5e938d2fb83af4/CSAB-en-US.vtt","kind":"subtitles","srcLang":"en","default":true},"image":{"src":"//images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg","alt":"Scopus CSAB","width":1440,"height":1080}}},"showVideoTitle":false,"primaryLink":null,"secondaryLink":null,"body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Scopus content is reviewed and ultimately selected by an independent Content Selection and Advisory Board (CSAB), an international group of scientists and researchers with journal editor experience and who represent the major scientific disciplines indexed on Scopus.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Year-round, the CSAB members are responsible for reviewing all new titles that are suggested for indexing on Scopus. They also review and ensure that the quality of existing content is maintained.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"target":{"sys":{"id":"6U5C8xIAARQbgHiC58icOS","type":"Link","linkType":"Asset"}},"content":{"sys":{"id":"6U5C8xIAARQbgHiC58icOS"},"contentType":"video/mp4","title":"ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4","url":"//videos.ctfassets.net/o78em1y1w4i4/6U5C8xIAARQbgHiC58icOS/6b930ab10781c48b93f151e9a06d06e0/ACAD_SC_VID_CSAB_purpose_expertcuration__1_.mp4"}},"content":[{"data":{},"marks":[],"value":"Watch the video","nodeType":"text"}],"nodeType":"asset-hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Learn more about the Scopus ","nodeType":"text"},{"data":{"target":{"sys":{"id":"OwFywv2CwnbHmhk5uXyhN","type":"Link","linkType":"Entry"}},"content":{"sys":{"id":"OwFywv2CwnbHmhk5uXyhN"},"__typename":"Page","title":"Content selection and advisory board","slug":"/products/scopus/content/content-selection-and-advisory-board"}},"content":[{"data":{},"marks":[],"value":"CSAB","nodeType":"text"}],"nodeType":"entry-hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}]}}},{"id":"4voySZ8Mn6sRYhAsQUQiCH","componentProps":{"typeName":"RichTextFull","props":{"document":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Stringent selection standards","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"Every year, thousands of new titles are suggested for inclusion in Scopus, but only 33% of those titles meet the rigorous technical criteria. And of those roughly 1,200 titles, only 50% are accepted after review by our independent Content Selection Advisory Board.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"imageWithCaption":{"image":{"src":"","alt":"","width":0,"height":0},"caption":null},"callToActionLink":null}}},{"id":"7sG5eKx1msNp9o7XpIbzfo","componentProps":{"typeName":"TeaserGroup","props":{"title":"","teasers":[{"id":"10uYTWr2GR8MJ6vTk39GEF","title":"Our selection process and policy","media":{"__typename":"Image","body":{"src":"//images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg","alt":"Scopus standards","width":1260,"height":946}},"showVideoTitle":false,"primaryLink":null,"secondaryLink":null,"body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"We are proud of our transparent selection process and independent review board. The international experts on our CSAB continually review new title requests using both quantitative and qualitative measures. Only serial titles may be suggested to the CSAB for inclusion on Scopus, including journals, book series and conference series.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Read our ","nodeType":"text"},{"data":{"target":{"sys":{"id":"34CzLr8RBMMWysH2hDH5lC","type":"Link","linkType":"Entry"}},"content":{"sys":{"id":"34CzLr8RBMMWysH2hDH5lC"},"__typename":"Page","title":"Scopus content policy and selection","slug":"/products/scopus/content/content-policy-and-selection"}},"content":[{"data":{},"marks":[],"value":"Content Policy \u0026 Selection","nodeType":"text"}],"nodeType":"entry-hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Have a title to suggest? Complete this ","nodeType":"text"},{"data":{"uri":"https://suggestor.step.scopus.com/suggest-title"},"content":[{"data":{},"marks":[],"value":"form","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}]}}},{"id":"27s44x1p67utxFWQQJzfIr","componentProps":{"typeName":"FrequentlyAskedQuestionsGroup","props":{"title":"About our content","shortDescription":"","helpLink":null,"questions":[{"question":"Journals","answer":{"text":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"The bulk of the content on Scopus is peer-reviewed journals which are selected according to our content coverage policy. Any serial publication with an ISSN, that meets the technical criteria can be suggested for review and covered on Scopus. Over 5,500 peer-reviewed titles are full open access titles (according to DOAJ and/or ROAD).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"question":"Trade journals","answer":{"text":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Serial publications covering and intended to reach a specific industry, trade or type of business. These publications usually are a magazine type of periodical with articles on topical subjects, news items and advertisements that appeal to those in the field. Trade journals are seldom refereed and do not always have an editorial board. Abstracts are usually short or nonexistent and few or no references are given. Usually an ISSN is available. Trade journals are included in Scopus because users and librarians consider selected articles to be scientifically relevant. Only articles or reviews of scientific relevance are included in Scopus.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"question":"Book series","answer":{"text":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"A serial publication that has an overall series title, an ISSN and in which every volume and/or issue in the series is also a book with an ISBN. Usually, but not always, each book has a book title separate from the series title and a different editor or editors. Typically, each book is a monographic publication. Book series are usually published irregularly.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"question":"Books (non-serial titles)","answer":{"text":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"A non-serial source is a publication with an ISBN and is usually a monograph or composed work. One-off book publications covered in Scopus includes monographs, edited volumes, major reference works and graduate level textbooks. Over 217,000 book titles are in Scopus that significantly increase the breadth and depth of coverage for book-oriented disciplines in the social sciences and humanities. Books are indexed on both a book and a chapter level. Book selection policy is publisher-based, meaning publishers are reviewed based on the relevancy and quality of their complete books list. Once a publisher is accepted, all books from that publisher that fit the scope of the project are indexed in Scopus.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},{"question":"Conference material","answer":{"text":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Conference material enters Scopus in two different ways: (1) as a special issue of a regular journal, (2) as a dedicated conference proceeding. Proceedings can be published as serial or non-serial, and may contain either the full articles of the papers presented or only the abstracts. The source title usually includes words like proceeding(s), meeting(s), conference(s), symposium/symposia, seminar(s) or workshop(s) (or their synonyms in other languages), although some journals also include proceeding(s) in the title. Scopus covers conferences that publish full-text papers (i.e., document type conference papers).","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}}]}}},{"id":"6rDr9owPZozHiVu2Gjiqsv","componentProps":{"typeName":"RichTextFull","props":{"document":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Titles on Scopus","nodeType":"text"}],"nodeType":"heading-3"},{"data":{},"content":[{"data":{},"marks":[],"value":"Content types included on Scopus are either serial publications that have an ISSN (International Standard Serial Number), such as journals, book series and conference series, or non-serial publications that have an ISBN (International Standard Book Number), such as monographs or one-off conference materials. To check if a title is on Scopus, visit the freely available ","nodeType":"text"},{"data":{"uri":"https://www.scopus.com/sources?zone=TopNavBar\u0026origin=NO%20ORIGIN%20DEFINED"},"content":[{"data":{},"marks":[],"value":"Source Title page","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" or consult the title lists below.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"target":{"sys":{"id":"7xtaTxNiNcWRTeZkV86eNy","type":"Link","linkType":"Asset"}},"content":{"sys":{"id":"7xtaTxNiNcWRTeZkV86eNy"},"contentType":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","title":"Scopus source title list - August 2026","url":"//downloads.ctfassets.net/o78em1y1w4i4/7xtaTxNiNcWRTeZkV86eNy/69cf2d506c905dc299531fdc93049dbb/ext_list_Aug_2026.xlsx"}},"content":[{"data":{},"marks":[],"value":"Download the Source title list","nodeType":"text"}],"nodeType":"asset-hyperlink"},{"data":{},"marks":[],"value":" (includes discontinued sources list)","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"target":{"sys":{"id":"2uPDv7HcQRnPoxj5xyGhBS","type":"Link","linkType":"Asset"}},"content":{"sys":{"id":"2uPDv7HcQRnPoxj5xyGhBS"},"contentType":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","title":"Scopus book title list - Q2 2026","url":"//downloads.ctfassets.net/o78em1y1w4i4/2uPDv7HcQRnPoxj5xyGhBS/62cc5084eb5566e942271f09e37ccf80/Scopus_book_list_Q2.xlsx"}},"content":[{"data":{},"marks":[],"value":"Download the Book title list","nodeType":"text"}],"nodeType":"asset-hyperlink"},{"data":{},"marks":[],"value":"\n","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[{"type":"italic"}],"value":"Please note that the information present on the Source profile page in Scopus and the Source title list available above are updated monthly. ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"italic"}],"value":"It ensures that the information related to sources such as the Title, ISSN and publisher details, remain up-to-date and accurate. ASJCs are updated annually during May/June. Additionally, new source profile pages are now added to Scopus monthly.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"imageWithCaption":{"image":{"src":"","alt":"","width":0,"height":0},"caption":null},"callToActionLink":null}}}]}],"templateVariant":null,"preview":false,"useTOC":false}}},"navigation":[{"id":"navigation-item-0","title":"Academic \u0026 Government","items":[{"title":"Explore all","items":[{"navigationItem":{"href":null,"label":"Academic \u0026 Government","accessibleLabel":null,"page":{"slug":"/academic-and-government"},"openInNewWindow":false},"description":""}]},{"title":"Featured products","items":[{"navigationItem":{"href":null,"label":"LeapSpace","accessibleLabel":null,"page":{"slug":"/products/leapspace"},"openInNewWindow":false},"description":"The research-grade AI workspace"},{"navigationItem":{"href":"https://shop.elsevier.com/","label":"Elsevier Shop","accessibleLabel":null,"openInNewWindow":true,"externa