v></li><li class="_1a5bjby2"><div class="_1a5bjby5 _1a5bjby1 _16jmeqb1s _16jmeqb10 _16jmeqb8"><svg viewBox="0 0 24 24" class="_1a5bjby3" width="16" height="16"><path fill="currentColor" fill-rule="evenodd" d="M7.125 11.438 15.563 3l1.312 1.313-7.125 7.125 7.125 7.124-1.313 1.313-8.437-8.438Z" clip-rule="evenodd"></path></svg><a class="_16jmeqb1k _16jmeqb1he _16jmeqb1oe _16jmeqb1oj _16jmeqb4w" href="/products/scopus"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Scopus</span></a><svg viewBox="0 0 24 24" class="_1a5bjby0" width="16" height="16"><path fill="currentColor" fill-rule="evenodd" d="m7.125 18.563 7.125-7.125-7.125-7.126L8.438 3l8.437 8.438-8.438 8.437-1.312-1.313Z" clip-rule="evenodd"></path></svg></div></li><li class="_1a5bjby2"><div class="_1a5bjby5 _1a5bjby1 _16jmeqb1s _16jmeqb10 _16jmeqb8"><svg viewBox="0 0 24 24" class="_1a5bjby3" width="16" height="16"><path fill="currentColor" fill-rule="evenodd" d="M7.125 11.438 15.563 3l1.312 1.313-7.125 7.125 7.125 7.124-1.313 1.313-8.437-8.438Z" clip-rule="evenodd"></path></svg><p class="gv4p8b0 _1a5bjby4 _16jmeqb1f8 _16jmeqb1f9" aria-current="page">Scopus Content</p></div></li></ol></nav><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88 _16jmeqbk4 _16jmeqbk9 _16jmeqbkm" style="--_1kbq9x80:var(--_99wljgf)"><div class="_166ug2a0"><div class="e8isn70 _1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class="_1u13v720 _16jmeqbk9 _16jmeqb8" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4 _16jmeqbqh" data-aa-region="hero-ctas"><div class="_16jmeqbjk _16jmeqbjh _16jmeqbjq _16jmeqblk _16jmeqblh _16jmeqblq _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqbbc _16jmeqbfl"><h1 class="m0fuh0 tlzusk2 tlzuskk tlzusk12 tlzusk1k _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="1">Scopus Content </h1><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk8 tlzuskq tlzusk18 _16jmeqb1f9" data-text-size="lg"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Scopus covers 330 disciplines to ensure researchers, instructors, librarians and students have confidence that they are not missing out on the vital information they need to advance their research and scholarship. </p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Learn how the interdisciplinary depth and breadth of Scopus can help drive your organization’s research forward.</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><a class="_16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="/products/scopus/contact-us"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Contact us</span></a></p></div></div><div class=" _1bkgapk0 _16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb8"></div></div></div></div><div class="_16jmeqbo8 _16jmeqboc _16jmeqbp5 _16jmeqbr4"><div class="_16jmeqb1s _16jmeqb2c _16jmeqb9 _16jmeqb6"><img class="e8isn72 popcxs1 popcxs3 _16jmeqbal _16jmeqbbc" src="//images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=1044&amp;q=75" alt="Close up of businessman writing down formulas" width="1044" height="912" sizes="(min-width: 650px) 560px, 70vw" srcSet="//images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=640&amp;q=75 640w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=750&amp;q=75 750w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=828&amp;q=75 828w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=1080&amp;q=75 1080w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=1200&amp;q=75 1200w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=1400&amp;q=75 1400w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=1920&amp;q=75 1920w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=2048&amp;q=75 2048w, //images.ctfassets.net/o78em1y1w4i4/1uqMHuUkznyzu2n0yIimH5/21840a6cbe833287bccbd780b00861b5/Scopus_Content_-_header.png?fm=webp&amp;w=3840&amp;q=75 3840w" decoding="async" loading="eager" fetchPriority="high"/></div></div></div></div></div><div class="_166ug2a0"><div class="_16jmeqbk4 _16jmeqbk9 _16jmeqbkm _16jmeqbm4 _16jmeqbm9 _16jmeqbmm _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_5b8yjf0" id="0-content-coverage"><div class="_16jmeqbk4 _16jmeqbk9 _16jmeqbkm _16jmeqbm4 _16jmeqbm9 _16jmeqbmm _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class=""><div class="_16jmeqbk8 _16jmeqbkn _16jmeqbm8 _16jmeqbmn _16jmeqb1s _16jmeqb18 _16jmeqb0"><article class=""><div class="_1u13v720 _16jmeqbj1 _16jmeqbjo _16jmeqbl0 _16jmeqblx _16jmeqbl2" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqboc _16jmeqbr4 _16jmeqbql _16jmeqbqe _16jmeqbsl _16jmeqb1s _16jmeqb8 _16jmeqb2c"><div class="_16jmeqb24" data-testid="teaser-image"><img class="popcxs1 popcxs3" src="https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=1260/output=webp/quality=75" alt="" width="1260" height="946" sizes="(min-width: 650px) 480px, 80vw" srcSet="https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=640/output=webp/quality=75 640w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=750/output=webp/quality=75 750w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=828/output=webp/quality=75 828w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=1080/output=webp/quality=75 1080w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=1200/output=webp/quality=75 1200w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=1400/output=webp/quality=75 1400w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=1920/output=webp/quality=75 1920w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=2048/output=webp/quality=75 2048w, https://media.ffycdn.net/eu/elsevier/d/cfaa8959100c4e40bf16863edf91c931?mod=v1/resize=3840/output=webp/quality=75 3840w" decoding="async" loading="lazy" fetchPriority="auto"/></div></div><div class="_1v4akrz1 _16jmeqboc _16jmeqbp5 _16jmeqbr4"><div class="_1v4akrz2 _16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_16jmeqbsk _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3" data-testid="teaser-title">Unparalleled access to critical research from around the world</h3></div></div><div class="_16jmeqbak _16jmeqbes _16jmeqb1s _16jmeqb8 _16jmeqb2c _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb24"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div data-testid="teaser-list-item"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Researchers, scholars and librarians trust the information and data they discover on Scopus because the content from more than 7,000 publishers is meticulously reviewed and selected by an independent Content Selection and Advisory Board (CSAB).</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Read about the content that Scopus offers in our <a class="external _16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="//assets.ctfassets.net/o78em1y1w4i4/EX1iy8VxBeQKf8aN2XzOp/a13b1bf2789b73e04ae3436035a0682d/Scopus_Content_coverage_Guide_Jun26.pdf" rel="noopener" target="_blank" aria-label="Content Coverage Guide opens in new tab/window"><span class="_16jmeqb1w _16jmeqb10 _16jmeqb8 _16jmeqb1oe _16jmeqb1oj"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Content Coverage Guide</span><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M5.438 6.75h10.7L4.983 17.906l1.326 1.328 11.13-11.13V18.75h1.875V4.875H5.438V6.75Z" clip-rule="evenodd"></path></svg></span><span class="_13sjisp0">opens in new tab/window</span></a></p></div></div></div></div></div></div></div></div></div></article></div></div></div></div><div class="section-rtf"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">Scopus includes ...</h3></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><figure class=""><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb18 _16jmeqb0"><img class="popcxs1 popcxs3" src="//images.ctfassets.net/o78em1y1w4i4/sUawGK6z3SOgf2PpnntAI/33fc4ad6d3637ae230e7dc8f48ef1c12/CS-1421_Scopus_infographic_template.png?fm=webp&amp;w=2560&amp;q=75" alt="Infographic showing Scopus coverage counts" width="2560" height="1280" srcSet="//images.ctfassets.net/o78em1y1w4i4/sUawGK6z3SOgf2PpnntAI/33fc4ad6d3637ae230e7dc8f48ef1c12/CS-1421_Scopus_infographic_template.png?fm=webp&amp;w=2560&amp;q=75 1x, //images.ctfassets.net/o78em1y1w4i4/sUawGK6z3SOgf2PpnntAI/33fc4ad6d3637ae230e7dc8f48ef1c12/CS-1421_Scopus_infographic_template.png?fm=webp&amp;w=4000&amp;q=75 2x" decoding="async" loading="lazy" fetchPriority="auto"/><figcaption class="gv4p8b0 _16jmeqb1gi _16jmeqb1f8 _16jmeqb1f9"><div class="gv4p8b0 tlzuska tlzusks tlzusk1a _16jmeqb1f9" data-text-size="sm"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Numbers shown are rounded and current as of July 2025. Scopus is updated daily.</p></div></div></figcaption></div></figure></div></div><div class=""><div class="mwublu0 _16jmeqb3g _16jmeqb3p _16jmeqb3u _16jmeqb7g _16jmeqb7p _16jmeqb7u"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class="_1u13v720 _16jmeqbkc _16jmeqb4" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqboh _16jmeqbr4 _16jmeqbr1"><figure class=""><div class="_16jmeqbk0 _16jmeqbk5 _16jmeqbm0 _16jmeqbm5 _16jmeqb1s _16jmeqb18 _16jmeqb4"><blockquote class="gv4p8b0 _8u4s230 mwublu2 _16jmeqb150 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1eu _16jmeqbvg _16jmeqbvh _16jmeqbtq _16jmeqb1fp" lang="en"><span class="gv4p8b0 _8u4s231 _8u4s232 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1k _16jmeqb18 _16jmeqb0"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Having a database as inclusive and interdisciplinary as Scopus is invaluable to us.</span></div></span></blockquote><div class="_16jmeqbjg _16jmeqbjm _16jmeqblg _16jmeqblm _16jmeqb1s _16jmeqb18 _16jmeqb11 _16jmeqb4 _16jmeqb9"><div class="mkts3l0 _16jmeqbx0 _16jmeqbzc _16jmeqb11o _16jmeqb140 _16jmeqb1fi _16jmeqb15k _16jmeqbsw"><img class="popcxs1 popcxs3 _16jmeqbx0 _16jmeqbzc _16jmeqb11o _16jmeqb140 _16jmeqb15o _16jmeqb24 _16jmeqb2c" src="//images.ctfassets.net/o78em1y1w4i4/4DZbWN8j1qNlo35UjxRPaY/de55f519a5dccd06fc7fa8446cd93f84/Bruce_Abbott_headshot.jpg?fm=webp&amp;w=88&amp;q=75" alt="Headshot of Bruce Abbott" width="88" height="88" srcSet="//images.ctfassets.net/o78em1y1w4i4/4DZbWN8j1qNlo35UjxRPaY/de55f519a5dccd06fc7fa8446cd93f84/Bruce_Abbott_headshot.jpg?fm=webp&amp;w=88&amp;q=75 1x, //images.ctfassets.net/o78em1y1w4i4/4DZbWN8j1qNlo35UjxRPaY/de55f519a5dccd06fc7fa8446cd93f84/Bruce_Abbott_headshot.jpg?fm=webp&amp;w=176&amp;q=75 2x" decoding="async" loading="lazy" fetchPriority="auto"/></div><figcaption class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb1f8"><p class="m0fuh0 tlzusk6 tlzusko tlzusk1o _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga _16jmeqb1f8" data-heading-level="5">Bruce Abbott</p><p class="gv4p8b0 tlzuska tlzusks tlzusk1a _16jmeqb1f9" data-text-size="sm">Health Sciences Librarian at Blaisdell Medical Library, University of California, Davis Health Care (USA)<!-- --> </p></figcaption></div></div></figure></div></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class=""><div class="_16jmeqbk8 _16jmeqbkn _16jmeqbm8 _16jmeqbmn _16jmeqb1s _16jmeqb18 _16jmeqb0"><article class=""><div class="_1u13v720 _16jmeqbj1 _16jmeqbjo _16jmeqbl0 _16jmeqblx _16jmeqbl2" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqboc _16jmeqbr4 _16jmeqbql _16jmeqbqe _16jmeqbsl _16jmeqb1s _16jmeqb8 _16jmeqb2c"><div class="_16jmeqb24" data-testid="teaser-image"><img class="popcxs1 popcxs3" src="//images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=1260&amp;q=75" alt="" width="1260" height="772" sizes="(min-width: 650px) 480px, 80vw" srcSet="//images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=640&amp;q=75 640w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=750&amp;q=75 750w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=828&amp;q=75 828w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=1080&amp;q=75 1080w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=1200&amp;q=75 1200w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=1400&amp;q=75 1400w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=1920&amp;q=75 1920w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=2048&amp;q=75 2048w, //images.ctfassets.net/o78em1y1w4i4/6h9OY0bSQ8tNNw6SCURgKU/b0f64ca2e60d64869c4b336171b23e80/Scopus_Content_teaser_2.png?fm=webp&amp;w=3840&amp;q=75 3840w" decoding="async" loading="lazy" fetchPriority="auto"/></div></div><div class="_1v4akrz1 _16jmeqboc _16jmeqbp5 _16jmeqbr4"><div class="_1v4akrz2 _16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_16jmeqbsk _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3" data-testid="teaser-title">Preprints in Scopus</h3></div></div><div class="_16jmeqbak _16jmeqbes _16jmeqb1s _16jmeqb8 _16jmeqb2c _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb24"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div data-testid="teaser-list-item"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Scopus incorporates 2M+ documents from seven leading preprint servers. Preprints are preliminary, unpublished, non-peer-reviewed versions of scholarly papers that precede publication and act as an early indication of research. Preprints from 2017 and onward can be explored as part of a Scopus search and are included as a content type in Author profiles.</p></div></div></div></div></div></div></div></div></div></article></div></div></div></div><div class="section-rtf"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">Historical depth: Why citations matter</h3><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">With more than 2.4b cited references in Scopus, each publication indexed has, on average, 10-15% more citations than our nearest competitor. More cited references mean you get:</p><ul class="_1w1hhao0 _16jmeqb18 _16jmeqb1s _16jmeqbjc" role="list"><li class=""><div class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb10 _16jmeqb4"><span class="_1w1hhao3 _16jmeqbsw _16jmeqb1ha _16jmeqb1w _16jmeqbo _16jmeqb1ha _16jmeqb8" aria-hidden="true"><span class="_16jmeqb1s _16jmeqb10 _16jmeqb8"><svg fill="currentColor" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="6.3"></circle></svg></span></span><div class="_16jmeqbt8"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">More extensive bibliometric and historic trends analyses</p></div></div></li><li class=""><div class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb10 _16jmeqb4"><span class="_1w1hhao3 _16jmeqbsw _16jmeqb1ha _16jmeqb1w _16jmeqbo _16jmeqb1ha _16jmeqb8" aria-hidden="true"><span class="_16jmeqb1s _16jmeqb10 _16jmeqb8"><svg fill="currentColor" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="6.3"></circle></svg></span></span><div class="_16jmeqbt8"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">More complete author profiles</p></div></div></li><li class=""><div class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb10 _16jmeqb4"><span class="_1w1hhao3 _16jmeqbsw _16jmeqb1ha _16jmeqb1w _16jmeqbo _16jmeqb1ha _16jmeqb8" aria-hidden="true"><span class="_16jmeqb1s _16jmeqb10 _16jmeqb8"><svg fill="currentColor" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="6.3"></circle></svg></span></span><div class="_16jmeqbt8"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Improved <i>h</i>-index measures for authors</p></div></div></li></ul><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Want to get a better representation of your scholarly output and increase your visibility? Validate your Author Profile today to ensure your citations and <i>h</i>-index score are accurate.</p></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><figure class=""><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb18 _16jmeqb0"><img class="popcxs1 popcxs3" src="//images.ctfassets.net/o78em1y1w4i4/7H6Bo4jkfzqZGRejVpyQ4A/77d3a3f552b587a8596e652102c35a67/Scopus_historical_depth.jpg?fm=webp&amp;w=800&amp;q=75" alt="Scopus historical depth timeline" width="800" height="418" srcSet="//images.ctfassets.net/o78em1y1w4i4/7H6Bo4jkfzqZGRejVpyQ4A/77d3a3f552b587a8596e652102c35a67/Scopus_historical_depth.jpg?fm=webp&amp;w=800&amp;q=75 1x, //images.ctfassets.net/o78em1y1w4i4/7H6Bo4jkfzqZGRejVpyQ4A/77d3a3f552b587a8596e652102c35a67/Scopus_historical_depth.jpg?fm=webp&amp;w=1600&amp;q=75 2x" decoding="async" loading="lazy" fetchPriority="auto"/><figcaption class="gv4p8b0 _16jmeqb1gi _16jmeqb1f8 _16jmeqb1f9"><div class="gv4p8b0 tlzuska tlzusks tlzusk1a _16jmeqb1f9" data-text-size="sm"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Content on Scopus extends back to 1788 and references date from the 1970s.</p></div></div></figcaption></div></figure></div></div><div class="section-rtf"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">Expertly curated content</h3><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">We seek out and ensure that only the most trusted, peer-reviewed scientific articles, books and conference papers are available on Scopus.</p></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class=""><div class="_16jmeqbk8 _16jmeqbkn _16jmeqbm8 _16jmeqbmn _16jmeqb1s _16jmeqb18 _16jmeqb0"><article class=""><div class="_1u13v720 _16jmeqbj1 _16jmeqbjo _16jmeqbl0 _16jmeqblx _16jmeqbl2" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqboc _16jmeqbr4 _16jmeqbql _16jmeqbqe _16jmeqbsl _16jmeqb1s _16jmeqb8 _16jmeqb2c"><div class="o0gjse0 _16jmeqbx8 _16jmeqbzk _16jmeqb11w _16jmeqb148 _16jmeqb15k _16jmeqb24 _16jmeqb1e0 _16jmeqb1fi _16jmeqb8 _16jmeqb1s" style="aspect-ratio:1440 / 1080" aria-label="ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4"><video preload="none" src="//videos.ctfassets.net/o78em1y1w4i4/6U5C8xIAARQbgHiC58icOS/6b930ab10781c48b93f151e9a06d06e0/ACAD_SC_VID_CSAB_purpose_expertcuration__1_.mp4" style="display:none" aria-hidden="true"></video><div class="_16jmeqbx8 _16jmeqbzk _16jmeqb11w _16jmeqb148 _16jmeqb15k _16jmeqb24 _16jmeqb2c"><img class="o0gjse2 popcxs1 popcxs3 _16jmeqb1g7" src="//images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=1440&amp;q=75" alt="Scopus CSAB" width="1440" height="1080" sizes="(min-width: 650px) 640px, 80vw" srcSet="//images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=640&amp;q=75 640w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=750&amp;q=75 750w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=828&amp;q=75 828w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=1080&amp;q=75 1080w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=1200&amp;q=75 1200w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=1400&amp;q=75 1400w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=1920&amp;q=75 1920w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=2048&amp;q=75 2048w, //images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg?fm=webp&amp;w=3840&amp;q=75 3840w" decoding="async" loading="lazy" fetchPriority="auto"/><div class="_16jmeqb90 _16jmeqb9d _16jmeqb9i _16jmeqb50 _16jmeqb5d _16jmeqb5i _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb10 _16jmeqb8 _16jmeqbs _16jmeqb1a0 _16jmeqb15o _16jmeqb24 _16jmeqb6w _16jmeqb75 _16jmeqb7i"><button class="w17eg90 _16jmeqbxw _16jmeqb108 _16jmeqb12k _16jmeqb14w _16jmeqb1w _16jmeqbo _16jmeqb8 w17eg93 w17eg9d w17eg97 o0gjse1" data-testid="teaser-play-button"><svg fill="currentColor" viewBox="0 0 24 24" class="o0gjse5" width="24" height="24"><path fill="currentColor" d="M5.375 20.546v-17l17 8.5-17 8.5Z"></path></svg><span class="_13sjisp0">Play</span></button></div></div><script data-testid="json-ld" type="application/ld+json">{"@context":"https://schema.org/","@type":"VideoObject","name":"ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4","description":"ACAD_SC_VID_CSAB_purpose_expertcuration (1).mp4","thumbnailURL":"//images.ctfassets.net/o78em1y1w4i4/2SuUYeMhIooGIol7OIwai6/3db3aa19fa3b998ecc133dcc05b50177/Scopus_CSAB_video_image.jpg","embedURL":"//videos.ctfassets.net/o78em1y1w4i4/6U5C8xIAARQbgHiC58icOS/6b930ab10781c48b93f151e9a06d06e0/ACAD_SC_VID_CSAB_purpose_expertcuration__1_.mp4","uploaddate":"2023-09-19T13:05:08.907Z","inlanguage":"en-US","publisher":{"@type":"Organization","name":"Elsevier","logo":{"@type":"ImageObject","url":"/images/elsevier-logo.svg"}}}</script></div></div><div class="_1v4akrz1 _16jmeqboc _16jmeqbp5 _16jmeqbr4"><div class="_1v4akrz2 _16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_16jmeqbsk _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3" data-testid="teaser-title">Content Selection and Advisory Board</h3></div></div><div class="_16jmeqbak _16jmeqbes _16jmeqb1s _16jmeqb8 _16jmeqb2c _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb24"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div data-testid="teaser-list-item"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Scopus content is reviewed and ultimately selected by an independent Content Selection and Advisory Board (CSAB), an international group of scientists and researchers with journal editor experience and who represent the major scientific disciplines indexed on Scopus.</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Year-round, the CSAB members are responsible for reviewing all new titles that are suggested for indexing on Scopus. They also review and ensure that the quality of existing content is maintained.</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><a class="external _16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="//videos.ctfassets.net/o78em1y1w4i4/6U5C8xIAARQbgHiC58icOS/6b930ab10781c48b93f151e9a06d06e0/ACAD_SC_VID_CSAB_purpose_expertcuration__1_.mp4" rel="noopener" target="_blank" aria-label="Watch the video opens in new tab/window"><span class="_16jmeqb1w _16jmeqb10 _16jmeqb8 _16jmeqb1oe _16jmeqb1oj"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Watch the video</span><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M5.438 6.75h10.7L4.983 17.906l1.326 1.328 11.13-11.13V18.75h1.875V4.875H5.438V6.75Z" clip-rule="evenodd"></path></svg></span><span class="_13sjisp0">opens in new tab/window</span></a></p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Learn more about the Scopus <a class="_16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="/products/scopus/content/content-selection-and-advisory-board"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">CSAB</span></a>.</p></div></div></div></div></div></div></div></div></div></article></div></div></div></div><div class="section-rtf"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">Stringent selection standards</h3><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Every year, thousands of new titles are suggested for inclusion in Scopus, but only 33% of those titles meet the rigorous technical criteria. And of those roughly 1,200 titles, only 50% are accepted after review by our independent Content Selection Advisory Board.</p></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgf)"><div class=""><div class="_16jmeqbk8 _16jmeqbkn _16jmeqbm8 _16jmeqbmn _16jmeqb1s _16jmeqb18 _16jmeqb0"><article class=""><div class="_1u13v720 _16jmeqbj1 _16jmeqbjo _16jmeqbl0 _16jmeqblx _16jmeqbl2" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqboc _16jmeqbr4 _16jmeqbql _16jmeqbqe _16jmeqbsl _16jmeqb1s _16jmeqb8 _16jmeqb2c"><div class="_16jmeqb24" data-testid="teaser-image"><img class="popcxs1 popcxs3" src="//images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=1260&amp;q=75" alt="" width="1260" height="946" sizes="(min-width: 650px) 480px, 80vw" srcSet="//images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=640&amp;q=75 640w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=750&amp;q=75 750w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=828&amp;q=75 828w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=1080&amp;q=75 1080w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=1200&amp;q=75 1200w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=1400&amp;q=75 1400w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=1920&amp;q=75 1920w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=2048&amp;q=75 2048w, //images.ctfassets.net/o78em1y1w4i4/4SDST6jJG7ijCpkzy0dPB/f739fd0f2ddee4549ce2257ebb3cc906/scopus_standard_2023.jpg?fm=webp&amp;w=3840&amp;q=75 3840w" decoding="async" loading="lazy" fetchPriority="auto"/></div></div><div class="_1v4akrz1 _16jmeqboc _16jmeqbp5 _16jmeqbr4"><div class="_1v4akrz2 _16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_16jmeqbsk _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3" data-testid="teaser-title">Our selection process and policy</h3></div></div><div class="_16jmeqbak _16jmeqbes _16jmeqb1s _16jmeqb8 _16jmeqb2c _16jmeqboc _16jmeqbr4"><div class="_16jmeqbjo _16jmeqblo _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb24"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div data-testid="teaser-list-item"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">We are proud of our transparent selection process and independent review board. The international experts on our CSAB continually review new title requests using both quantitative and qualitative measures. Only serial titles may be suggested to the CSAB for inclusion on Scopus, including journals, book series and conference series.</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Read our <a class="_16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="/products/scopus/content/content-policy-and-selection"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Content Policy &amp; Selection</span></a>.</p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Have a title to suggest? Complete this <a class="_16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="https://suggestor.step.scopus.com/suggest-title" rel="noopener" target="_blank" aria-label="form opens in new tab/window"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">form<span class="gv4p8b0 _17x85qk1 _16jmeqb1f8 _16jmeqb1f9"><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 _17x85qk0"><path fill="currentColor" fill-rule="evenodd" d="M5.438 6.75h10.7L4.983 17.906l1.326 1.328 11.13-11.13V18.75h1.875V4.875H5.438V6.75Z" clip-rule="evenodd"></path></svg></span></span><span class="_13sjisp0">opens in new tab/window</span></a>.</p></div></div></div></div></div></div></div></div></div></article></div></div></div></div><div class=""><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="_1u13v720 _16jmeqbk0 _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4 _16jmeqbq6"><div class="_16jmeqbjy _16jmeqbjt _16jmeqbjk _16jmeqbly _16jmeqblt _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><h2 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">About our content</h2></div></div><div class="_16jmeqbo8 _16jmeqboc _16jmeqbou _16jmeqbr4" data-testid="faq"><div class="" role="region"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb7c _16jmeqb1su"><button class="ou5ptd0 _16jmeqb150 _16jmeqb1ga" type="button" aria-expanded="false" aria-controls="faq-133-1-journals"><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb4 _16jmeqbw"><h3 class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md">Journals</h3><svg viewBox="0 0 24 24" class=" nddnvd6 nddnvd8 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M3.563 9.563 4.875 8.25 12 15.375l7.125-7.125 1.313 1.313L12 18 3.562 9.562Z" clip-rule="evenodd"></path></svg></div></button><div class="" hidden="" id="faq-133-1-journals"><div class="ou5ptd1 _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_1u13v720 _16jmeqbjg _16jmeqbjl _16jmeqbjq _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">The bulk of the content on Scopus is peer-reviewed journals which are selected according to our content coverage policy. Any serial publication with an ISSN, that meets the technical criteria can be suggested for review and covered on Scopus. Over 5,500 peer-reviewed titles are full open access titles (according to DOAJ and/or ROAD).</p></div></div></div></div></div></div></div></div><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb7c _16jmeqb1su"><button class="ou5ptd0 _16jmeqb150 _16jmeqb1ga" type="button" aria-expanded="false" aria-controls="faq-133-2-trade-journals"><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb4 _16jmeqbw"><h3 class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md">Trade journals</h3><svg viewBox="0 0 24 24" class=" nddnvd6 nddnvd8 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M3.563 9.563 4.875 8.25 12 15.375l7.125-7.125 1.313 1.313L12 18 3.562 9.562Z" clip-rule="evenodd"></path></svg></div></button><div class="" hidden="" id="faq-133-2-trade-journals"><div class="ou5ptd1 _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_1u13v720 _16jmeqbjg _16jmeqbjl _16jmeqbjq _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Serial publications covering and intended to reach a specific industry, trade or type of business. These publications usually are a magazine type of periodical with articles on topical subjects, news items and advertisements that appeal to those in the field. Trade journals are seldom refereed and do not always have an editorial board. Abstracts are usually short or nonexistent and few or no references are given. Usually an ISSN is available. Trade journals are included in Scopus because users and librarians consider selected articles to be scientifically relevant. Only articles or reviews of scientific relevance are included in Scopus.</p></div></div></div></div></div></div></div></div><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb7c _16jmeqb1su"><button class="ou5ptd0 _16jmeqb150 _16jmeqb1ga" type="button" aria-expanded="false" aria-controls="faq-133-3-book-series"><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb4 _16jmeqbw"><h3 class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md">Book series</h3><svg viewBox="0 0 24 24" class=" nddnvd6 nddnvd8 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M3.563 9.563 4.875 8.25 12 15.375l7.125-7.125 1.313 1.313L12 18 3.562 9.562Z" clip-rule="evenodd"></path></svg></div></button><div class="" hidden="" id="faq-133-3-book-series"><div class="ou5ptd1 _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_1u13v720 _16jmeqbjg _16jmeqbjl _16jmeqbjq _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">A serial publication that has an overall series title, an ISSN and in which every volume and/or issue in the series is also a book with an ISBN. Usually, but not always, each book has a book title separate from the series title and a different editor or editors. Typically, each book is a monographic publication. Book series are usually published irregularly.</p></div></div></div></div></div></div></div></div><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb7c _16jmeqb1su"><button class="ou5ptd0 _16jmeqb150 _16jmeqb1ga" type="button" aria-expanded="false" aria-controls="faq-133-4-books-non-serial-titles"><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb4 _16jmeqbw"><h3 class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md">Books (non-serial titles)</h3><svg viewBox="0 0 24 24" class=" nddnvd6 nddnvd8 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M3.563 9.563 4.875 8.25 12 15.375l7.125-7.125 1.313 1.313L12 18 3.562 9.562Z" clip-rule="evenodd"></path></svg></div></button><div class="" hidden="" id="faq-133-4-books-non-serial-titles"><div class="ou5ptd1 _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_1u13v720 _16jmeqbjg _16jmeqbjl _16jmeqbjq _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">A non-serial source is a publication with an ISBN and is usually a monograph or composed work. One-off book publications covered in Scopus includes monographs, edited volumes, major reference works and graduate level textbooks. Over 217,000 book titles are in Scopus that significantly increase the breadth and depth of coverage for book-oriented disciplines in the social sciences and humanities. Books are indexed on both a book and a chapter level. Book selection policy is publisher-based, meaning publishers are reviewed based on the relevancy and quality of their complete books list. Once a publisher is accepted, all books from that publisher that fit the scope of the project are indexed in Scopus.</p></div></div></div></div></div></div></div></div><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0 _16jmeqb7c _16jmeqb1su"><button class="ou5ptd0 _16jmeqb150 _16jmeqb1ga" type="button" aria-expanded="false" aria-controls="faq-133-5-conference-material"><div class="_16jmeqbjs _16jmeqbls _16jmeqb1s _16jmeqb10 _16jmeqb4 _16jmeqbw"><h3 class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md">Conference material</h3><svg viewBox="0 0 24 24" class=" nddnvd6 nddnvd8 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="M3.563 9.563 4.875 8.25 12 15.375l7.125-7.125 1.313 1.313L12 18 3.562 9.562Z" clip-rule="evenodd"></path></svg></div></button><div class="" hidden="" id="faq-133-5-conference-material"><div class="ou5ptd1 _16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_1u13v720 _16jmeqbjg _16jmeqbjl _16jmeqbjq _16jmeqblg _16jmeqbll _16jmeqblq" style="grid-template-columns:repeat(12, 1fr)"><div class="_16jmeqbo8 _16jmeqboc _16jmeqbr4"><div class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9"><div class="_16jmeqbjk _16jmeqblk _16jmeqb1s _16jmeqb18 _16jmeqb0"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Conference material enters Scopus in two different ways: (1) as a special issue of a regular journal, (2) as a dedicated conference proceeding. Proceedings can be published as serial or non-serial, and may contain either the full articles of the papers presented or only the abstracts. The source title usually includes words like proceeding(s), meeting(s), conference(s), symposium/symposia, seminar(s) or workshop(s) (or their synonyms in other languages), although some journals also include proceeding(s) in the title. Scopus covers conferences that publish full-text papers (i.e., document type conference papers).</p></div></div></div></div></div></div></div></div></div></div></div></div></div></div><div class="section-rtf"><div class="_1kbq9x82 _1kbq9x84 _1kbq9x85 _1kbq9x88" style="--_1kbq9x80:var(--_99wljgh)"><div class="gv4p8b0 tlzusk9 tlzuskr tlzusk19 _16jmeqb1f9" data-text-size="md"><div class="_16jmeqbjs _16jmeqbjy _16jmeqbls _16jmeqbly _16jmeqb1s _16jmeqb18 _16jmeqb0"><h3 class="m0fuh0 tlzusk4 tlzuskm tlzusk14 tlzusk1m _16jmeqbak _16jmeqbco _16jmeqbes _16jmeqbgw _16jmeqb1ev _16jmeqb1f9 _16jmeqb1ga" data-heading-level="3">Titles on Scopus</h3><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz">Content types included on Scopus are either serial publications that have an ISSN (International Standard Serial Number), such as journals, book series and conference series, or non-serial publications that have an ISBN (International Standard Book Number), such as monographs or one-off conference materials. To check if a title is on Scopus, visit the freely available <a class="_16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="https://www.scopus.com/sources?zone=TopNavBar&amp;origin=NO%20ORIGIN%20DEFINED" rel="noopener" target="_blank" aria-label="Source Title page opens in new tab/window"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Source Title page<span class="gv4p8b0 _17x85qk1 _16jmeqb1f8 _16jmeqb1f9"><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 _17x85qk0"><path fill="currentColor" fill-rule="evenodd" d="M5.438 6.75h10.7L4.983 17.906l1.326 1.328 11.13-11.13V18.75h1.875V4.875H5.438V6.75Z" clip-rule="evenodd"></path></svg></span></span><span class="_13sjisp0">opens in new tab/window</span></a> or consult the title lists below.</p><ul class="_1w1hhao0 _16jmeqb18 _16jmeqb1s _16jmeqbjc" role="list"><li class=""><div class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb10 _16jmeqb4"><span class="_1w1hhao3 _16jmeqbsw _16jmeqb1ha _16jmeqb1w _16jmeqbo _16jmeqb1ha _16jmeqb8" aria-hidden="true"><span class="_16jmeqb1s _16jmeqb10 _16jmeqb8"><svg fill="currentColor" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="6.3"></circle></svg></span></span><div class="_16jmeqbt8"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><a class="download _16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="//downloads.ctfassets.net/o78em1y1w4i4/7xtaTxNiNcWRTeZkV86eNy/69cf2d506c905dc299531fdc93049dbb/ext_list_Aug_2026.xlsx" rel="noopener" target="_blank" aria-label="Download Download the Source title list opens in new tab/window"><span class="_16jmeqb1w _16jmeqb10 _16jmeqb8 _16jmeqb1oe _16jmeqb1oj"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Download the Source title list</span><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="m16.084 9.21 1.237 1.324-5.475 5.497-5.475-5.497L7.74 9.206l3.322 3.233V4.875h1.876v7.568l3.146-3.233Zm3.229 8.415v-3.75h1.875V19.5H2.813v-5.625h1.874v3.75h14.625Z" clip-rule="evenodd"></path></svg></span><span class="_13sjisp0">opens in new tab/window</span></a> (includes discontinued sources list)</p></div></div></li><li class=""><div class="_16jmeqbj4 _16jmeqbl4 _16jmeqb1s _16jmeqb10 _16jmeqb4"><span class="_1w1hhao3 _16jmeqbsw _16jmeqb1ha _16jmeqb1w _16jmeqbo _16jmeqb1ha _16jmeqb8" aria-hidden="true"><span class="_16jmeqb1s _16jmeqb10 _16jmeqb8"><svg fill="currentColor" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="6.3"></circle></svg></span></span><div class="_16jmeqbt8"><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><a class="download _16jmeqb1k _16jmeqb1ie _16jmeqb1oe _16jmeqb1oj" href="//downloads.ctfassets.net/o78em1y1w4i4/2uPDv7HcQRnPoxj5xyGhBS/62cc5084eb5566e942271f09e37ccf80/Scopus_book_list_Q2.xlsx" rel="noopener" target="_blank" aria-label="Download Download the Book title list opens in new tab/window"><span class="_16jmeqb1w _16jmeqb10 _16jmeqb8 _16jmeqb1oe _16jmeqb1oj"><span class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9">Download the Book title list</span><svg viewBox="0 0 24 24" class=" nddnvd1 nddnvd9 nddnvdb"><path fill="currentColor" fill-rule="evenodd" d="m16.084 9.21 1.237 1.324-5.475 5.497-5.475-5.497L7.74 9.206l3.322 3.233V4.875h1.876v7.568l3.146-3.233Zm3.229 8.415v-3.75h1.875V19.5H2.813v-5.625h1.874v3.75h14.625Z" clip-rule="evenodd"></path></svg></span><span class="_13sjisp0">opens in new tab/window</span></a></p></div></div></li></ul><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><i>Please note that the information present on the Source profile page in Scopus and the Source title list available above are updated monthly. </i></p><p class="gv4p8b0 _16jmeqb1f8 _16jmeqb1f9 _16jmeqb1fz"><i>It ensures that the information related to sources such as the Title, ISSN and publisher details, remain up-to-date and accurate. ASJCs are updated annually during May/June. Additionally, new source profile pages are now added to Scopus monthly.</i></p></div></div></div></div></div></div></div></div><article class="hz4xsm0 hz4xsm1 _99wljgb2 _16jmeqb3g _16jmeqb5g _16jmeqb7g _16jmeqb9g _16jmeqbws _16jmeqbz4 _16jmeqb11g _16jmeqb13s _16jmeqb1s _16jmeqb4 _16jmeqb9 _16jmeqb15k _16jmeqb1fi"><div class="_16jmeqb24 _16jmeqbck _16jmeqbal _16jmeqb1e8"><div class="_1u13v720 _16jmeqbjw _16jmeqbj1 _16jmeqblg _16jmeqbll _